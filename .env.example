# ESFlow — API keys for LLM benchmark runner
# Copy this file to .env and fill in your keys.
# .env is gitignored and will not be committed.

# OpenAI-compatible API key (GPT-5, etc.)
LLM_API_KEY=sk-...

# Google Gemini API key
GEMINI_API_KEY=...

# Optional: separate keys for different billing accounts
# LLM_API_KEY_BIRTHRIGHT=sk-...
# LLM_API_KEY_PROJECT=sk-...
